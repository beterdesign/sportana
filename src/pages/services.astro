---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Statement from '../components/Statement.astro';
import Rows from '../components/Rows.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { services, servicesFaq } from '../data/site.js';

const rows = services.map((s) => ({
  title: s.title,
  sub: s.sub,
  text: s.long,
  chips: s.deliverables,
  aside: s.price,
}));
---

<Base
  title="Services | Sportana"
  description="TODO: page description"
>
  <Header />
  <main>
    <PageHero label="The services" big="SERVICES" italic="of the studio." meta="Sportana · TODO">
      TODO: one or two sentences introducing the services.
    </PageHero>
    <Statement
      label="The principle"
      text="TODO: the principle behind the services, two sentences."
    />
    <Rows label="Three services" items={rows} />
    <Faq
      title="Questions about the services"
      intro="TODO"
      items={servicesFaq}
    />
    <Contact title="Let's talk about your project." />
  </main>
  <Footer />
</Base>
