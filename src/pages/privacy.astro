---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

// Standard policy for studio-built sites. Review per client: providers, forms, analytics, jurisdiction.
const updated = 'TODO: date';
---

<Base title="Privacy policy | Sportana" description="TODO: page description">
  <Header />
  <main>
    <PageHero label="Legal" big="PRIVACY" italic="policy." meta={`Last updated ${updated}`}>
      How personal data is collected, used and protected when you visit sportana.rs or get in touch.
    </PageHero>

    <section class="legal">
      <p class="serif legal__label">(The policy)</p>
      <div class="prose">
        <p>
          Sportana (“we”, “our” or “us”) respects your privacy and is committed to protecting your personal data. This
          policy explains how we collect, use and safeguard your information when you visit this website.
        </p>

        <h2 id="collect">1. Information we collect</h2>
        <ul>
          <li>Personal information you choose to share, such as your name, email address and company name</li>
          <li>Information you provide through the project form or by email</li>
          <li>Technical data such as IP address, browser type and device information</li>
          <li>Usage data such as the pages you visit and the time spent on the site</li>
        </ul>
        <p>
          The project form on this site does not store your answers. When you send it, your own email app opens with the
          details filled in, and nothing reaches us until you send that email.
        </p>

        <h2 id="use">2. How we use your information</h2>
        <ul>
          <li>To respond to inquiries and communication requests</li>
          <li>To provide and improve our services</li>
          <li>To maintain website performance and security</li>
          <li>To comply with legal obligations</li>
        </ul>
        <p>We do not sell your personal data.</p>

        <h2 id="basis">3. Legal basis (GDPR)</h2>
        <p>If you are in the European Economic Area, we process your data based on:</p>
        <ul>
          <li>Your consent</li>
          <li>The need to perform a contract</li>
          <li>Our legitimate business interests</li>
        </ul>

        <h2 id="sharing">4. Data sharing</h2>
        <p>We do not share your personal data with third parties, except:</p>
        <ul>
          <li>When required by law</li>
          <li>
            With trusted service providers, strictly for operating this website: Cloudflare (hosting and security), Sanity
            (content management), Fontshare (web fonts) and Calendly (if you book a call)
          </li>
        </ul>

        <h2 id="retention">5. Data retention</h2>
        <p>We keep your data only as long as necessary for the purposes described in this policy.</p>

        <h2 id="rights">6. Your rights</h2>
        <ul>
          <li>Access your personal data</li>
          <li>Request correction or deletion</li>
          <li>Withdraw consent at any time</li>
          <li>Lodge a complaint with a data protection authority</li>
        </ul>

        <h2 id="cookies">7. Cookies</h2>
        <p>
          This website does not use advertising or tracking cookies. Our hosting provider may set strictly necessary
          cookies for security. You can control cookies through your browser settings.
        </p>

        <h2 id="get-in-touch">8. Contact</h2>
        <p>
          Questions about this policy? Write to <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 4vw;
    padding: 14vh var(--gutter) 16vh;
    border-top: 1px solid var(--line);
  }
  .legal__label {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .legal {
      grid-template-columns: 1fr;
    }
  }
</style>
