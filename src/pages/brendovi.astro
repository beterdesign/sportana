---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { getBrands, getProducts, img } from '../lib/sanity.js';

const [brands, products] = await Promise.all([getBrands(), getProducts()]);
const unbranded = products.filter((p) => !p.brand).length;
const sorted = [...brands].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'sr'));
---

<Base
  title="Brendovi | Kettler, Everlast, Spalding i drugi | Sportana"
  description={`Brendovi u Sportani: ${sorted.slice(0, 8).map((b) => b.name).join(', ')} i drugi. Izaberite brend i pogledajte sve njegove proizvode.`}
>
  <PageHead title="Brendovi" eyebrow={`${brands.length} brendova`} crumbs={[{ label: 'Brendovi' }]} />
  <section class="brandgrid wrap">
    <ul>
      {
        sorted.map((b) => (
          <li>
            <a href={`/prodavnica?brend=${b.slug}`} class="brand">
              <span class="brand__img">{b.cover && <img src={img(b.cover, 500)} alt="" loading="lazy" />}</span>
              <span class="brand__name">{b.name}</span>
              <span class="brand__count">
                {b.count} {b.count % 10 === 1 && b.count % 100 !== 11 ? 'proizvod' : 'proizvoda'} <Icon name="arrow" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="muted brandgrid__note">
      Još {unbranded} proizvoda je bez istaknutog brenda: <a href="/prodavnica" class="link">pogledajte celu prodavnicu</a>
    </p>
  </section>
</Base>

<style>
  .brandgrid ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: clamp(10px, 1.2vw, 18px);
  }
  .brand {
    display: grid;
    gap: 6px;
    padding: 14px;
    border-radius: var(--radius);
    background: var(--white);
    transition: box-shadow 0.25s;
  }
  .brand:hover {
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }
  .brand__img {
    display: block;
    aspect-ratio: 4 / 3;
    margin-bottom: 8px;
  }
  .brand__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .brand__name {
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1;
  }
  .brand__count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .brandgrid__note {
    margin-top: 28px;
  }
</style>
