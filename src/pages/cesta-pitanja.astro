---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { faq } from '../data/site.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.flatMap((g) => g.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } }))),
};
---

<Base title="Česta pitanja | Sportana" description="Odgovori na česta pitanja o pretrazi, poručivanju, cenama i isporuci sportske opreme iz Sportane." schema={schema}>
  <PageHead title="Česta pitanja" crumbs={[{ label: 'Česta pitanja' }]} />
  <section class="faq wrap">
    {
      faq.map((g) => (
        <div class="faq__group">
          <h2 class="h3">{g.title}</h2>
          <div>
            {g.items.map((item, i) => (
              <details class="faq__item" open={i === 0}>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .faq {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }
  .faq__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px 32px;
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__group > div {
    border-top: 1px solid var(--line);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
  }
  .faq__item[open] summary::after {
    content: '−';
  }
  .faq__item p {
    padding-bottom: 20px;
    max-width: 60ch;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .faq__group {
      grid-template-columns: 1fr;
    }
  }
</style>
