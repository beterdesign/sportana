---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Statement from '../../components/Statement.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { categories } from '../../data/site.js';
import { getProjectPages, img, srcset, richText } from '../../lib/sanity.js';

export async function getStaticPaths() {
  const projects = await getProjectPages();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: p, index, next } = Astro.props;
const label = Object.fromEntries(categories.map((c) => [c.id, c.label]))[p.category];
const facts = [
  { k: 'Client', v: p.title },
  { k: 'Sector', v: label },
  p.services?.length && { k: 'Services', v: p.services.join(', ') },
  p.year && { k: 'Year', v: p.year },
  p.partner && { k: 'Partner', v: p.partner },
].filter(Boolean);
---

<Base title={`${p.title} — Case study | Sportana`} description={p.excerpt}>
  <Header />
  <main>
    <section class="cs">
      <div class="cs__top" data-hero-fade>
        <span class="serif cs__label">(Case study)</span>
        <span class="eyebrow cs__meta">{String(index + 1).padStart(2, '0')} · {label}</span>
      </div>
      <h1 class="cs__title">
        <span class="mask"><span data-hero-line>{p.title}</span></span>
        {p.tag && <span class="mask serif cs__tag"><span data-hero-line>{p.tag}</span></span>}
      </h1>
      <div class="cs__foot">
        <p class="cs__excerpt" data-hero-fade>{p.excerpt}</p>
        <dl class="cs__facts" data-hero-fade>
          {
            facts.map((f) => (
              <div>
                <dt class="eyebrow">{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
          {
            p.liveUrl && (
              <div>
                <dt class="eyebrow">Live</dt>
                <dd>
                  <a href={p.liveUrl} target="_blank" rel="noopener" class="cs__live">
                    {p.liveUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>

    <figure class="cover" style={`--tone:${p.tone}`}>
      <img src={img(p.coverImage, 2400)} srcset={srcset(p.coverImage)} sizes="100vw" alt={p.coverImage?.alt || ''} data-parallax />
    </figure>

    {
      p.brief?.length > 0 && (
        <section class="story">
          <p class="serif story__label">(The story)</p>
          <div class="prose" data-reveal set:html={richText(p.brief)} />
        </section>
      )
    }

    {
      p.scope?.length > 0 && (
        <section class="scope">
          <span class="eyebrow scope__label">(What we did{p.partner ? `, with ${p.partner.replace(' Inc.', '')}` : ''})</span>
          <ol class="scope__list">
            {p.scope.map((s, i) => (
              <li data-reveal>
                <span class="serif">({String(i + 1).padStart(2, '0')})</span>
                <p>{s}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      p.gallery?.length > 0 && (
        <section class="gallery">
          {p.gallery.map((g) => (
            <img src={img(g, 1800)} srcset={srcset(g)} sizes="100vw" alt={g.alt || ''} loading="lazy" data-reveal />
          ))}
        </section>
      )
    }

    {p.closing && <Statement label="In short" text={p.closing} />}

    <a href={next.href} class="next" data-preview={next.image}>
      <span class="eyebrow next__k">Next project</span>
      <span class="next__name">{next.title}</span>
      <span class="serif next__tag">{next.tag} →</span>
    </a>
    <div class="cursor-preview" data-cursor-preview data-offset-x="40" data-offset-y="-240" aria-hidden="true">
      <img alt="" />
    </div>

    <Contact title="Your brand, next?" />
  </main>
  <Footer />
</Base>

<style>
  .cs {
    min-height: 88svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 130px var(--gutter) 8vh;
  }
  .cs__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: auto;
  }
  .cs__label {
    color: var(--muted);
  }
  .cs__meta {
    color: var(--muted-dark);
  }
  .cs__title {
    margin: 6vh 0 7vh;
    font-weight: inherit;
  }
  .cs__title > .mask:first-child {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(56px, 10.5vw, 180px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .cs__tag {
    font-size: clamp(30px, 4.4vw, 72px);
    line-height: 1.1;
    color: var(--muted);
    padding-left: 10vw;
    margin-top: 0.1em;
  }
  .cs__foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4vw;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .cs__excerpt {
    max-width: 460px;
    color: #bdb9b0;
    font-size: 17px;
    line-height: 1.7;
  }
  .cs__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 2rem;
    margin: 0;
  }
  .cs__facts dt {
    color: var(--muted-dark);
    font-size: 10px;
    margin-bottom: 4px;
  }
  .cs__facts dd {
    margin: 0;
    font-size: 14px;
  }
  .cs__live {
    border-bottom: 1px solid currentColor;
  }

  .cover {
    margin: 0;
    height: 92vh;
    overflow: hidden;
    background: var(--tone);
  }
  .cover img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 4vw;
    padding: 16vh var(--gutter) 12vh;
  }
  .story__label {
    color: var(--muted);
  }

  .scope {
    padding: 10vh var(--gutter) 14vh;
    border-top: 1px solid var(--line);
  }
  .scope__label {
    display: block;
    color: var(--muted-dark);
    margin-bottom: 6vh;
  }
  .scope__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .scope__list li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 2rem;
    align-items: baseline;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .scope__list li:first-child {
    border-top: 1px solid var(--line);
  }
  .scope__list span {
    color: var(--muted);
  }
  .scope__list p {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 24em;
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    padding: 0 var(--gutter) 14vh;
  }
  .gallery img:nth-child(3n + 1) {
    grid-column: 1 / -1;
  }

  .next {
    display: block;
    padding: 14vh var(--gutter);
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    transition: background 0.6s var(--ease);
  }
  .next__k {
    display: block;
    color: var(--muted-dark);
    margin-bottom: 3vh;
  }
  .next__name {
    display: block;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(48px, 9vw, 150px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    transition: transform 0.8s var(--ease);
  }
  .next__tag {
    display: block;
    margin-top: 2vh;
    padding-left: 10vw;
    font-size: clamp(22px, 2.6vw, 40px);
    color: var(--muted-dark);
  }
  .next:hover .next__name {
    transform: translateX(2vw);
  }

  @media (max-width: 900px) {
    .cs__foot,
    .story {
      grid-template-columns: 1fr;
    }
    .cs__tag {
      padding-left: 4vw;
    }
    .cover {
      height: 60vh;
    }
    .scope__list li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
