---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Rail from '../components/Rail.astro';
import ProductCard from '../components/ProductCard.astro';
import { getSettings, getCategories, getBrands, getProducts, img, srcset } from '../lib/sanity.js';
import { site } from '../data/site.js';
import logo from '../../public/brand/logo.svg?raw';

const [settings, categories, brands, products] = await Promise.all([getSettings(), getCategories(), getBrands(), getProducts()]);

const fresh = products.filter((p) => p.isNew);
const featured = products.filter((p) => p.featured);
const sale = products.filter((p) => p.sale).sort((a, b) => b.off - a.off);
const topBrands = brands.filter((b) => b.count >= 2).sort((a, b) => b.count - a.count).slice(0, 10);
const total = products.length;
// category tiles in full rows of 2, 3, 4 (then 3, 4, …) on a 12-column grid, so no tile is left alone in a row
const tileRows = [];
for (let left = categories.length, k = 0; left > 0; k++) {
  const want = k === 0 ? 2 : k % 2 ? 3 : 4;
  const n = left < want ? left : left - want === 1 ? want - 1 : want;
  tileRows.push(n);
  left -= n;
}
const tiles = tileRows.flatMap((n) => Array.from({ length: n }, () => ({ span: 12 / n, size: n <= 2 ? 'l' : n === 3 ? 'm' : 's' })));
const tileSizes = { l: '56vw', m: '45vw', s: '45vw' };
const saleEnds = settings?.saleEnds && new Date(settings.saleEnds) > new Date() ? settings.saleEnds : null;

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Kategorije',
  itemListElement: categories.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: `https://sportana.rs/kategorija/${c.slug}` })),
};
---

<Base title={site.title} description={site.description} image={img(settings?.heroImage, 1200) || '/og.jpg'} schema={itemList}>
  <!-- hero: full-bleed video with the giant wordmark (Achilles Heel) -->
  <section class="hero">
    <div class="hero__media">
      <img
        class="hero__poster"
        src={img(settings?.heroImage, 2400)}
        srcset={srcset(settings?.heroImage)}
        sizes="(max-aspect-ratio: 16/9) 180vh, 100vw"
        alt={settings?.heroImage?.alt || ''}
        fetchpriority="high"
      />
      <video class="hero__video" data-hero-video data-src="/video/hero.mp4" data-src-sm="/video/hero-sm.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
    </div>
    <div class="hero__content">
      <div class="hero__text">
        <h1 class="h1 hero__title">{settings?.heroTitle || 'Treniraj gde god da si'}</h1>
        <p class="hero__lead">{settings?.heroText}</p>
        <div class="hero__actions">
          <a href="/prodavnica" class="btn btn--volt">Kupuj sve ({total}) <Icon name="arrow" size={18} /></a>
          <button class="btn btn--light" data-search-open><Icon name="search" size={18} /> Pretraži</button>
        </div>
      </div>
      <div class="hero__mark" aria-hidden="true" set:html={logo} />
    </div>
  </section>

  <!-- categories -->
  <section class="cats" aria-labelledby="cats-title">
    <div class="section-head">
      <div data-reveal>
        <p class="eyebrow muted">{categories.length} kategorija · {total} proizvoda</p>
        <h2 class="h2" id="cats-title">Šta trenirate?</h2>
      </div>
      <a href="/prodavnica" class="link">Sva prodavnica</a>
    </div>
    <ul class="cats__grid wrap">
      {
        categories.map((c, i) => (
          <li class:list={['cats__item', `cats__item--${tiles[i].size}`, { 'cats__item--lead': i === 0 && categories.length % 2 }]} style={`--span: ${tiles[i].span}`}>
            <a href={`/kategorija/${c.slug}`} class="cats__link">
              <img src={img(c.image, 1200)} srcset={srcset(c.image, [600, 900, 1200, 1600])} sizes={`(max-width: 600px) 112vw, (max-width: 960px) ${i === 0 && categories.length % 2 ? '112vw' : '67vw'}, ${tileSizes[tiles[i].size]}`} alt={c.image?.alt || ''} loading="lazy" />
              <span class="cats__shade" />
              <span class="cats__text">
                <span class="cats__count">{c.count} proizvoda</span>
                <span class="h3 cats__title">{c.title}</span>
                <span class="cats__short">{c.short}</span>
              </span>
              <span class="cats__arrow"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {fresh.length > 0 && <Rail title="Novo u ponudi" eyebrow="Upravo stiglo" products={fresh} href="/prodavnica?novo=1" />}

  <!-- brands: list + photo that follows the hovered brand (Achilles Heel) -->
  <section class="brands wrap" data-brands>
    <div class="brands__photo" aria-hidden="true">
      {
        topBrands.map((b, i) => (
          <img src={img(b.cover, 900)} alt="" loading="lazy" data-brand-photo={b.slug} class:list={{ 'is-on': i === 0 }} />
        ))
      }
    </div>
    <div class="brands__list">
      <p class="eyebrow muted" data-reveal>Brendovi</p>
      <ul>
        {
          topBrands.map((b) => (
            <li>
              <a href={`/prodavnica?brend=${b.slug}`} data-brand={b.slug}>
                <span class="brands__name">{b.name}</span>
                <span class="brands__count">{b.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/brendovi" class="link">Svi brendovi ({brands.length})</a>
    </div>
  </section>

  <!-- sale: banner with countdown (Ridely) + rail -->
  {
    sale.length > 0 && (
      <section class="sale">
        <div class="sale__banner">
          <div class="sale__copy" data-reveal>
            <p class="eyebrow">Do −{sale[0].off}% · {sale.length} proizvoda</p>
            <h2 class="display sale__title">{settings?.saleTitle || 'Akcija'}</h2>
            <p class="sale__text">{settings?.saleText}</p>
            <a href="/akcija" class="btn btn--volt">
              Sve na akciji <Icon name="arrow" size={18} />
            </a>
          </div>
          {saleEnds && (
            <div class="sale__clock" data-countdown={saleEnds} data-countdown-wrap>
              <p class="eyebrow">Akcija traje još</p>
              <div class="sale__units">
                {[['d', 'dana'], ['h', 'sati'], ['m', 'min'], ['s', 'sek']].map(([u, l]) => (
                  <span><b data-unit={u}>00</b><small>{l}</small></span>
                ))}
              </div>
            </div>
          )}
        </div>
        <Rail title="Na akciji" products={sale} href="/akcija" />
      </section>
    )
  }

  {featured.length > 0 && <Rail title="Izdvajamo" eyebrow="Za kućnu teretanu, salu i dvorište" products={featured} href="/prodavnica" />}

  <!-- benefits strip (Ridely) -->
  {
    settings?.benefits?.length > 0 && (
      <section class="benefits wrap" aria-label="Zašto Sportana">
        <ul>
          {settings.benefits.map((b, i) => (
            <li data-reveal>
              <span class="benefits__n">0{i + 1}</span>
              <p class="benefits__title">{b.title}</p>
              <p class="muted">{b.text}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- about: pinned photo + text (Achilles Heel "About us") -->
  <section class="about wrap">
    <div class="about__photo">
      <img src={img(categories.find((c) => c.slug === 'borilacki-sportovi')?.image, 1600)} srcset={srcset(categories.find((c) => c.slug === 'borilacki-sportovi')?.image)} sizes="(max-width: 960px) 134vw, 64vw" alt="Bokser u rukavicama u polumračnoj sali" loading="lazy" />
    </div>
    <div class="about__text">
      <p class="eyebrow muted" data-reveal>O nama</p>
      <h2 class="h2" data-reveal>{settings?.aboutTitle || 'Oprema koja izdrži trening'}</h2>
      <p class="lead" data-reveal>{settings?.aboutText}</p>
      <div class="about__facts" data-reveal>
        <div><b>2015.</b><span>osnovana u Vrbasu</span></div>
        <div><b>{total}</b><span>proizvoda u ponudi</span></div>
        <div><b>{brands.length}</b><span>brendova</span></div>
      </div>
      <a href="/o-nama" class="link">Više o Sportani</a>
    </div>
  </section>

  <!-- in plain words (SEO / AEO) -->
  <section class="plain wrap">
    <p class="eyebrow muted">Sportana u par reči</p>
    <p class="plain__text">
      Sportana je online prodavnica sportske i fitnes opreme iz Vrbasa ({site.legal}, od 2015). U ponudi su trake za
      trčanje i sobni bicikli, tegovi, bučice i klupe za kućnu teretanu, oprema za boks, kik boks i karate, lopte i
      oprema za košarku, fudbal i odbojku, stolovi za stoni tenis, steznici i oprema za oporavak, kao i autići na
      akumulator, balans bicikli i skejtovi za decu. Šaljemo širom Srbije.
    </p>
  </section>
</Base>

<script>
  // brands: the photo follows the hovered or focused brand
  const box = document.querySelector('[data-brands]');
  box?.querySelectorAll('[data-brand]').forEach((a) => {
    const on = () =>
      box.querySelectorAll('[data-brand-photo]').forEach((img) => img.classList.toggle('is-on', (img as HTMLElement).dataset.brandPhoto === (a as HTMLElement).dataset.brand));
    a.addEventListener('mouseenter', on);
    a.addEventListener('focus', on);
  });
</script>

<style>
  /* hero */
  .hero {
    position: relative;
    height: calc(100svh - var(--hdr, 109px) - 32px);
    min-height: 560px;
    max-height: 1080px;
    color: var(--paper);
    overflow: hidden;
    background: var(--ink);
  }
  .hero__media,
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 11, 10, 0.1) 30%, rgba(11, 11, 10, 0.75));
  }
  .hero__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(20px, 3vw, 40px);
    padding: 0 var(--gutter) clamp(20px, 2.4vw, 36px);
  }
  .hero__text {
    display: grid;
    gap: 16px;
    max-width: 640px;
  }
  .hero__title {
    animation: rise 1s var(--ease) 0.1s both;
  }
  .hero__lead {
    font-size: var(--t-lead);
    max-width: 30em;
    color: rgba(246, 245, 241, 0.85);
    animation: rise 1s var(--ease) 0.2s both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
    animation: rise 1s var(--ease) 0.3s both;
  }
  .hero__mark {
    color: var(--paper);
    --ball: var(--volt);
    animation: rise 1.2s var(--ease) 0.15s both;
  }
  .hero__mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero__mark :global(.ball) {
    transform-box: fill-box;
    transform-origin: center;
    animation: bounce 1.4s var(--ease) 0.5s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }
  @keyframes bounce {
    0% {
      transform: translateY(-160%);
    }
    45% {
      transform: translateY(0) scale(1.08, 0.9);
    }
    65% {
      transform: translateY(-22%);
    }
    85% {
      transform: translateY(0) scale(1.03, 0.97);
    }
    100% {
      transform: none;
    }
  }

  /* categories */
  .cats__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 16px);
  }
  .cats__item {
    grid-column: span var(--span, 4);
  }
  .cats__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--paper);
    background: var(--ink-2);
  }
  .cats__item--l .cats__link {
    aspect-ratio: 16 / 10;
  }
  .cats__item--s .cats__link {
    aspect-ratio: 1;
  }
  .cats__item--s .cats__short {
    display: none;
  }
  .cats__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  .cats__link:hover img {
    transform: scale(1.05);
  }
  .cats__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(11, 11, 10, 0.78));
  }
  .cats__text {
    position: absolute;
    left: clamp(16px, 1.6vw, 24px);
    right: 64px;
    bottom: clamp(16px, 1.6vw, 24px);
    display: grid;
    gap: 6px;
  }
  .cats__count {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--volt);
  }
  .cats__title {
    font-size: clamp(1.6rem, 2.4vw, 2.6rem);
  }
  .cats__short {
    font-size: 14px;
    color: rgba(246, 245, 241, 0.8);
  }
  .cats__arrow {
    position: absolute;
    right: clamp(16px, 1.6vw, 24px);
    bottom: clamp(16px, 1.6vw, 24px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition:
      background 0.3s,
      transform 0.4s var(--ease);
  }
  .cats__link:hover .cats__arrow {
    background: var(--volt);
    transform: rotate(-45deg);
  }

  /* brands */
  .brands {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 96px);
    align-items: center;
  }
  .brands__photo {
    position: relative;
    aspect-ratio: 1;
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .brands__photo img {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.45s,
      transform 0.7s var(--ease);
  }
  .brands__photo img.is-on {
    opacity: 1;
    transform: none;
  }
  .brands__list ul {
    margin: 14px 0 26px;
    border-top: 1px solid var(--line);
  }
  .brands__list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .brands__name {
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 3.2vw, 3.1rem);
    line-height: 1;
    transition:
      transform 0.4s var(--ease),
      color 0.2s;
  }
  .brands__list a:hover .brands__name,
  .brands__list a:focus-visible .brands__name {
    transform: translateX(10px);
  }
  .brands__count {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  /* sale */
  .sale__banner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: end;
    margin: 0 var(--gutter) clamp(32px, 4vw, 56px);
    padding: clamp(28px, 4.5vw, 72px);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }
  .sale__copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .sale__copy .eyebrow {
    color: var(--volt);
  }
  .sale__title {
    color: var(--volt);
    font-style: italic;
  }
  .sale__text {
    max-width: 30em;
    color: rgba(246, 245, 241, 0.8);
  }
  .sale__clock .eyebrow {
    color: rgba(246, 245, 241, 0.6);
    margin-bottom: 12px;
  }
  .sale__units {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .sale__units span {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 14px 6px;
    border-radius: var(--radius);
    background: var(--ink-2);
  }
  .sale__units b {
    font-stretch: 68%;
    font-size: clamp(2rem, 3.4vw, 3.4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sale__units small {
    font-size: 12px;
    color: rgba(246, 245, 241, 0.6);
  }

  /* benefits */
  .benefits ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .benefits li {
    padding: 22px clamp(12px, 2vw, 28px) 4px 0;
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .benefits li + li {
    padding-left: clamp(12px, 2vw, 28px);
    border-left: 1px solid var(--line);
  }
  .benefits__n {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }
  .benefits__title {
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    line-height: 1.05;
  }

  /* about */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 96px);
    align-items: start;
  }
  .about__photo {
    position: sticky;
    top: calc(var(--hdr, 106px) + 32px);
  }
  .about__photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .about__text {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: clamp(0px, 4vw, 64px);
  }
  .about__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  .about__facts div {
    display: grid;
    gap: 2px;
  }
  .about__facts b {
    font-stretch: 68%;
    font-size: clamp(2rem, 3.4vw, 3.4rem);
    line-height: 1;
  }
  .about__facts span {
    font-size: 13px;
    color: var(--muted);
  }

  /* plain words */
  .plain {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 12px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }
  .plain__text {
    max-width: 52em;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .cats__item {
      grid-column: span 6;
    }
    .cats__item--lead {
      grid-column: 1 / -1;
    }
    .cats__item .cats__link {
      aspect-ratio: 4 / 3;
    }
    .cats__item--lead .cats__link {
      aspect-ratio: 16 / 9;
    }
    .cats__item--s .cats__short {
      display: block;
    }
    .brands,
    .about,
    .sale__banner {
      grid-template-columns: 1fr;
    }
    .brands__photo {
      display: none;
    }
    .about__photo {
      position: static;
    }
    .about__photo img {
      aspect-ratio: 16 / 10;
    }
    .benefits ul {
      grid-template-columns: 1fr 1fr;
    }
    .benefits li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .plain {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .cats__item {
      grid-column: 1 / -1;
    }
    .cats__item .cats__link,
    .cats__item--lead .cats__link {
      aspect-ratio: 16 / 10;
    }
    .hero {
      min-height: 520px;
      height: calc(100svh - 180px);
    }
    .benefits ul {
      grid-template-columns: 1fr;
    }
    .benefits li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
