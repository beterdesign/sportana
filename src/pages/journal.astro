---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { journalTopics } from '../data/site.js';
import { getPosts } from '../lib/sanity.js';

const posts = await getPosts();

const labels = Object.fromEntries(journalTopics.map((t) => [t.id, t.label]));
const [latest, ...rest] = posts;
---

<Base
  title="Journal | Sportana"
  description="TODO: page description"
>
  <Header />
  <main>
    <PageHero label="Field notes" big="JOURNAL" italic="from the studio." meta="Case studies · Guides · Studio news">
      TODO: one sentence on what the journal covers.
    </PageHero>

    {
      latest ? (
        <section class="latest">
          <a href={latest.href} class="latest__media" data-reveal>
            <img src={latest.image} alt="" loading="eager" />
          </a>
          <div class="latest__body" data-reveal>
            <span class="eyebrow latest__meta">Latest · {labels[latest.topic]}</span>
            <h2 class="latest__title">
              <a href={latest.href}>{latest.title}</a>
            </h2>
            <a href={latest.href} class="pill latest__cta">
              Read the story
            </a>
          </div>
        </section>
      ) : (
        <section class="latest">
          <p class="latest__meta eyebrow">No entries yet. Publish the first post in Sanity.</p>
        </section>
      )
    }

    <section class="index">
      <div class="index__head">
        <span class="eyebrow">All entries</span>
        <div class="index__filters" role="group" aria-label="Filter entries">
          {
            journalTopics.map((t, i) => (
              <button type="button" class="chip" data-filter={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {t.label}
              </button>
            ))
          }
        </div>
      </div>

      <ol class="index__list">
        {
          rest.map((p, i) => (
            <li data-category={p.topic}>
              <a href={p.href} class="entry" data-preview={p.image}>
                <span class="serif entry__num">({String(i + 2).padStart(2, '0')})</span>
                <h3 class="entry__title">{p.title}</h3>
                <span class="eyebrow entry__topic">{labels[p.topic]}</span>
                <span class="entry__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="cursor-preview" data-cursor-preview data-offset-x="40" data-offset-y="36" aria-hidden="true">
      <img alt="" />
    </div>

    <Contact title="Want to be the next story?" />
  </main>
  <Footer />
</Base>

<style>
  .latest {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 5vw;
    align-items: end;
    padding: 12vh var(--gutter);
    border-top: 1px solid var(--line);
  }
  .latest__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-3);
  }
  .latest__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }
  .latest__media:hover img {
    transform: scale(1.04);
  }
  .latest__meta {
    color: var(--muted-dark);
  }
  .latest__title {
    margin: 1.2rem 0 2.4rem;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(32px, 3.4vw, 54px);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .latest__cta {
    border-color: var(--line);
  }

  .index {
    padding: 8vh var(--gutter) 14vh;
  }
  .index__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 4vh;
    color: var(--muted-dark);
  }
  .index__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: 0.4s var(--ease);
  }
  .chip:hover {
    color: var(--cream);
    border-color: rgba(236, 233, 226, 0.4);
  }
  .chip[aria-pressed='true'] {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }
  .index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .index__list li[hidden] {
    display: none;
  }
  .entry {
    display: grid;
    grid-template-columns: 90px 1fr 160px 30px;
    gap: 2rem;
    align-items: center;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
    color: #8f8c84;
    transition: color 0.5s var(--ease), padding 0.6s var(--ease);
  }
  .entry:hover {
    color: var(--cream);
    padding-left: 12px;
  }
  .entry__num {
    color: var(--muted-dark);
  }
  .entry__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(20px, 2.1vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    max-width: 30em;
  }
  .entry__topic {
    color: var(--muted-dark);
    font-size: 10px;
  }
  .entry__arrow {
    justify-self: end;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: 0.5s var(--ease);
  }
  .entry:hover .entry__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .latest {
      grid-template-columns: 1fr;
    }
    .entry {
      grid-template-columns: 1fr 24px;
      gap: 0.6rem 1rem;
    }
    .entry__num {
      display: none;
    }
    .entry__topic {
      grid-row: 2;
    }
    .entry__arrow {
      opacity: 1;
      transform: none;
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
