---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/site.js';
import { getProjects } from '../lib/sanity.js';

const allProjects = await getProjects();

const labels = Object.fromEntries(categories.map((c) => [c.id, c.label]));
---

<Base
  title="Work | Sportana"
  description="TODO: page description"
>
  <Header />
  <main>
    <section class="wh">
      <h1 class="wh__title serif">
        <span class="mask">
          <span data-hero-line>
            TODO title<sup class="wh__count">selected</sup>
          </span>
        </span>
      </h1>
      <div class="wh__filters" role="group" aria-label="Filter projects" data-hero-fade>
        {
          categories.map((c, i) => (
            <button type="button" class="chip" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c.label}
            </button>
          ))
        }
      </div>
    </section>

    <ol class="list">
      {
        allProjects.map((p, i) => (
          <li class:list={['item', { 'is-flip': i % 2 }]} data-category={p.category}>
            <a href={p.href} class="item__media" style={`--tone:${p.tone}`} data-reveal>
              <img src={p.image} alt={`${p.name} website`} loading={i < 2 ? 'eager' : 'lazy'} />
              <span class="item__cta">View project ↗</span>
            </a>
            <div class="item__body" data-reveal>
              <span class="eyebrow item__meta">
                {String(i + 1).padStart(2, '0')} · {labels[p.category]}
              </span>
              <h2 class="item__name">
                <a href={p.href}>{p.name}</a>
              </h2>
              <p class="item__desc">{p.desc}</p>
              <p class="serif item__tags">{p.tags.join('   ·   ')}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <Contact title="Your brand, next?" />
  </main>
  <Footer />
</Base>

<style>
  .wh {
    padding: 160px var(--gutter) 8vh;
    background: var(--ink);
  }
  .wh__title {
    font-size: clamp(64px, 10.4vw, 172px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--cream);
  }
  .wh__count {
    font-family: var(--f-sans);
    font-style: normal;
    font-size: max(0.11em, 11px);
    letter-spacing: 0.04em;
    color: var(--muted);
    vertical-align: top;
    margin-left: 0.4em;
    position: relative;
    top: 1.4em;
  }
  .wh__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 5vh;
  }
  .chip {
    padding: 10px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: 0.4s var(--ease);
  }
  .chip:hover {
    color: var(--cream);
    border-color: rgba(236, 233, 226, 0.4);
  }
  .chip[aria-pressed='true'] {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 4vh var(--gutter) 10vh;
    background: var(--ink);
  }
  .item {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 5vw;
    align-items: center;
    padding: 7vh 0;
    border-top: 1px solid var(--line);
  }
  .item[hidden] {
    display: none;
  }
  .item.is-flip .item__media {
    order: 2;
  }
  .item__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10.5;
    overflow: hidden;
    background: var(--tone);
  }
  .item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease);
  }
  .item__media:hover img {
    transform: scale(1.05);
  }
  .item__cta {
    position: absolute;
    right: 16px;
    bottom: 16px;
    padding: 9px 15px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(8px);
    transition: 0.5s var(--ease);
  }
  .item__media:hover .item__cta {
    opacity: 1;
    transform: none;
  }
  .item__meta {
    color: var(--muted-dark);
  }
  .item__name {
    margin: 1rem 0 1.4rem;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(40px, 4.8vw, 80px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .item__name a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.6s var(--ease);
  }
  .item__name a:hover {
    background-size: 100% 2px;
  }
  .item__desc {
    max-width: 420px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }
  .item__tags {
    margin-top: 1.6rem;
    color: #a9a69e;
    font-size: 15px;
    white-space: pre;
  }

  @media (max-width: 900px) {
    .item {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .item.is-flip .item__media {
      order: 0;
    }
  }
</style>
