---
import logo from '../../public/brand/logo.svg?raw';
import { getCategories, getSettings } from '../lib/sanity.js';
import { site, infoLinks } from '../data/site.js';

const [categories, settings] = await Promise.all([getCategories(), getSettings()]);
const email = settings?.email || site.email;
const address = settings?.address || site.address;
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__grid">
    <div class="foot__intro">
      <p class="h3">Sportska i fitnes oprema iz Vrbasa, od 2015.</p>
      <button class="btn btn--volt" data-search-open>Pretraži proizvode</button>
    </div>
    <nav class="foot__col" aria-label="Kategorije u podnožju">
      <p class="eyebrow">Prodavnica</p>
      <ul>
        {categories.map((c) => <li><a href={`/kategorija/${c.slug}`}>{c.title}</a></li>)}
      </ul>
    </nav>
    <nav class="foot__col" aria-label="Informacije">
      <p class="eyebrow">Sportana</p>
      <ul>
        {infoLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/sacuvano">Sačuvano</a></li>
        <li><a href="/korpa">Korpa</a></li>
      </ul>
    </nav>
    <div class="foot__col">
      <p class="eyebrow">Kontakt</p>
      <ul>
        <li><a href={`mailto:${email}`}>{email}</a></li>
        {settings?.phone && <li><a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a></li>}
        <li>{address}</li>
        {settings?.hours && <li>{settings.hours}</li>}
        {settings?.kpUrl && <li><a href={settings.kpUrl} target="_blank" rel="noopener">KupujemProdajem ↗</a></li>}
        {settings?.instagram && <li><a href={settings.instagram} target="_blank" rel="noopener">Instagram ↗</a></li>}
      </ul>
    </div>
  </div>
  <div class="foot__mark" aria-hidden="true" set:html={logo} />
  <div class="foot__legal">
    <span>© {year} {site.legal}</span>
    <a href="/privatnost">Politika privatnosti</a>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--space);
    background: var(--ink);
    color: var(--paper);
    padding: clamp(48px, 6vw, 96px) var(--gutter) 24px;
    overflow: hidden;
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px clamp(24px, 3vw, 56px);
  }
  .foot__intro {
    display: grid;
    gap: 22px;
    align-content: start;
    justify-items: start;
    max-width: 22em;
  }
  .foot__col .eyebrow {
    color: rgba(246, 245, 241, 0.5);
    margin-bottom: 14px;
  }
  .foot__col ul {
    display: grid;
    gap: 9px;
  }
  .foot__col a {
    transition: color 0.2s;
  }
  .foot__col a:hover {
    color: var(--volt);
  }
  .foot__mark {
    margin-top: clamp(48px, 7vw, 120px);
    color: var(--paper);
    --ball: var(--volt);
  }
  .foot__mark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .foot__legal {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line-light);
    font-size: 13px;
    color: rgba(246, 245, 241, 0.6);
  }
  .foot__legal a:hover {
    color: var(--paper);
  }
  @media (max-width: 960px) {
    .foot__grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot__intro {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .foot__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
