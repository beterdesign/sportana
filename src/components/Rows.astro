---
// Numbered rows: "(01)  BIG TITLE  | sub, text, chips, aside" — used for services and principles.
interface Item {
  title: string;
  sub?: string;
  text: string;
  chips?: string[];
  aside?: string;
}
interface Props {
  label: string;
  items: Item[];
  id?: string;
}
const { label, items, id } = Astro.props;
---

<section class="rows" id={id}>
  <span class="eyebrow rows__label">({label})</span>
  <ol class="rows__list">
    {
      items.map((item, i) => (
        <li class="row" data-reveal>
          <span class="serif row__num">({String(i + 1).padStart(2, '0')})</span>
          <h3 class="row__title">{item.title}</h3>
          <div class="row__body">
            {item.sub && <p class="row__sub">{item.sub}</p>}
            <p class="row__text">{item.text}</p>
            {item.chips && (
              <ul class="row__chips">
                {item.chips.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            )}
            {item.aside && <span class="serif row__aside">{item.aside}</span>}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .rows {
    padding: 14vh var(--gutter) 10vh;
    background: var(--ink);
    border-top: 1px solid var(--line);
  }
  .rows__label {
    display: block;
    color: var(--muted-dark);
    margin-bottom: 8vh;
  }
  .rows__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 90px 1.25fr 1fr;
    gap: 2rem;
    align-items: start;
    padding: 6vh 0;
    border-bottom: 1px solid var(--line);
  }
  .row:first-child {
    border-top: 1px solid var(--line);
  }
  .row__num {
    color: var(--muted);
    font-size: 15px;
    padding-top: 0.6em;
  }
  .row__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(34px, 4.2vw, 68px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    transition: transform 0.7s var(--ease);
  }
  .row:hover .row__title {
    transform: translateX(1vw);
  }
  .row__body {
    max-width: 420px;
    padding-top: 0.5em;
  }
  .row__sub {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 0.8rem;
  }
  .row__text {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.75;
  }
  .row__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .row__chips li {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 11.5px;
    color: #a9a69e;
  }
  .row__aside {
    display: block;
    margin-top: 1.4rem;
    font-size: 20px;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
