---
// Search overlay: opens from every page (header button, "/" or Ctrl/⌘+K). Results come from /products.json
// and appear while typing; scripts/search.js does the matching (no diacritics needed, Serbian word endings).
import Icon from './Icon.astro';
import { getCategories } from '../lib/sanity.js';
import { popularSearches } from '../data/site.js';

const categories = await getCategories();
---

<div class="search" id="search" data-search hidden data-lenis-prevent>
  <div class="search__backdrop" data-search-close></div>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="Pretraga">
    <form class="search__bar" action="/pretraga" role="search" data-search-form>
      <Icon name="search" size={26} />
      <label class="sr-only" for="search-input">Pretraži proizvode</label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="Šta tražite? Npr. bučice, rukavice, traka…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        data-search-input
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="search__close" data-search-close aria-label="Zatvori pretragu">
        <span class="search__esc">Esc</span>
        <Icon name="close" size={22} />
      </button>
    </form>

    <div class="search__body">
      <div class="search__empty" data-search-empty>
        <div>
          <p class="eyebrow muted">Najčešće se traži</p>
          <ul class="search__chips">
            {popularSearches.map((q) => <li><button type="button" data-search-term={q}>{q}</button></li>)}
          </ul>
        </div>
        <div>
          <p class="eyebrow muted">Kategorije</p>
          <ul class="search__cats">
            {
              categories.map((c) => (
                <li>
                  <a href={`/kategorija/${c.slug}`}>
                    {c.title} <span>{c.count}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div data-search-recent hidden>
          <p class="eyebrow muted">Nedavno ste gledali</p>
          <ul class="search__recent" data-search-recent-list></ul>
        </div>
      </div>

      <div class="search__results" data-search-results hidden>
        <div class="search__groups" data-search-groups></div>
        <div>
          <p class="eyebrow muted search__count" data-search-count aria-live="polite"></p>
          <ul class="search__list" id="search-results" role="listbox" data-search-list></ul>
          <a href="/pretraga" class="link search__all" data-search-all>Svi rezultati</a>
        </div>
      </div>

      <div class="search__none" data-search-none hidden>
        <p class="h3">Nema rezultata za „<span data-search-none-q></span>”</p>
        <p class="muted">Proverite reč ili probajte nešto opštije, npr. „lopta” ili „tegovi”. Ili pogledajte kategorije:</p>
        <ul class="search__chips">
          {categories.map((c) => <li><a href={`/kategorija/${c.slug}`}>{c.title}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .search {
    position: fixed;
    inset: 0;
    z-index: 110;
  }
  .search__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 11, 10, 0.45);
    animation: s-fade 0.25s ease both;
  }
  .search__panel {
    position: absolute;
    inset: 0 0 auto;
    max-height: 100dvh;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    animation: s-drop 0.5s var(--ease) both;
    box-shadow: 0 30px 80px rgba(11, 11, 10, 0.25);
  }
  @keyframes s-drop {
    from {
      transform: translateY(-24px);
      opacity: 0;
    }
  }
  @keyframes s-fade {
    from {
      opacity: 0;
    }
  }
  .search__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 var(--gutter);
    height: clamp(72px, 9vw, 104px);
    border-bottom: 1px solid var(--line);
  }
  .search__bar input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    outline: none;
    font-size: clamp(1.25rem, 2.6vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .search__bar input::placeholder {
    color: #a6a59e;
  }
  .search__bar input::-webkit-search-cancel-button {
    display: none;
  }
  .search__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
  }
  .search__esc {
    font-size: 11px;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 7px;
    color: var(--muted);
  }
  .search__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(20px, 2.6vw, 36px) var(--gutter) clamp(24px, 3vw, 44px);
  }
  .search__empty {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .search__chips :is(button, a) {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 500;
    transition:
      background 0.2s,
      box-shadow 0.2s;
  }
  .search__chips :is(button, a):hover {
    background: var(--volt);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .search__cats {
    margin-top: 10px;
  }
  .search__cats a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }
  .search__cats a:hover {
    padding-left: 6px;
  }
  .search__cats span {
    color: var(--muted);
    font-weight: 500;
    font-size: 13px;
  }
  .search__recent {
    margin-top: 10px;
  }
  .search__results {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 48px);
  }
  .search__count {
    margin-bottom: 12px;
  }
  .search__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 4px 20px;
  }
  .search__all {
    margin-top: 22px;
  }
  .search__none {
    max-width: 760px;
  }
  .search__none .muted {
    margin-top: 10px;
  }

  /* rows rendered by search.js */
  .search :global(.hit) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 8px;
    margin: 0 -8px;
    border-radius: var(--radius);
  }
  .search :global(.hit[aria-selected='true']),
  .search :global(.hit:hover) {
    background: var(--white);
  }
  .search :global(.hit img) {
    width: 64px;
    height: 64px;
    object-fit: contain;
    background: var(--white);
    border-radius: var(--radius);
    mix-blend-mode: multiply;
  }
  .search :global(.hit__name) {
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search :global(.hit__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }
  .search :global(.hit__meta b) {
    color: var(--ink);
  }
  .search :global(.hit mark) {
    background: var(--volt);
    color: inherit;
    border-radius: 2px;
  }
  .search :global(.group) {
    margin-bottom: 22px;
  }
  .search :global(.group a) {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }
  .search :global(.group a span) {
    color: var(--muted);
    font-weight: 500;
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .search__panel {
      inset: 0;
    }
    .search__empty,
    .search__results {
      grid-template-columns: 1fr;
    }
    .search__esc {
      display: none;
    }
    .search__groups {
      order: 2;
    }
  }
</style>
