---
import { site } from '../data/site.js';
import ContactForm from './ContactForm.astro';

interface Props {
  title?: string;
}
const { title = 'A project in mind?' } = Astro.props;
---

<section class="contact" id="contact">
  <div class="contact__left">
    <a href={site.calendly} class="pill contact__badge" target="_blank" rel="noopener">Book a 30-min call</a>
    <h2 class="contact__title serif">
      <span class="mask"><span data-reveal-line>{title}</span></span>
    </h2>
    <a href={`mailto:${site.email}`} class="contact__email">{site.email}</a>
    <p class="contact__note">Three questions, two minutes. A reply within 48 business hours, with a first read of your project.</p>
  </div>

  <ContactForm />
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6vw;
    align-items: end;
    padding: 10vh var(--gutter) 16vh;
    background: var(--ink);
    position: relative;
    z-index: 4;
  }
  .contact__badge {
    color: var(--muted);
    border-color: var(--line);
    font-size: 10px;
    padding: 8px 14px;
  }
  .contact__title {
    margin-top: 2.6rem;
    font-size: clamp(44px, 5.4vw, 86px);
    line-height: 1.05;
    color: var(--muted);
  }
  .contact__email {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.1;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 2px no-repeat;
    padding-bottom: 6px;
    transition: background-size 0.6s var(--ease);
  }
  .contact__email:hover {
    background-size: 0 2px;
    background-position: 100% 100%;
  }
  .contact__note {
    max-width: 300px;
    margin-top: 2.4rem;
    color: var(--muted-dark);
    font-size: 13px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
