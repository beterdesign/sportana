---
import { site } from '../data/site.js';
// The 3-step project form, shared by the contact section and the Start a project popup.
const serviceOptions = ['Brand identity', 'Website design', 'SEO & AEO', 'All three'];
const budgets = ['$2k – 5k', '$5k – 10k', '$10k +', 'Not sure yet'];
---

<form class="form" data-form data-email={site.email} novalidate>
  <div class="form__top">
    <span class="form__step"><strong data-form-count>01</strong><em class="serif">/ 03</em></span>
    <span class="serif form__q" data-form-question>Who are you?</span>
  </div>

  <fieldset class="form__panel is-active" data-step="0" data-question="Who are you?">
    <legend class="sr-only">Your details</legend>
    <label class="field">
      <span class="eyebrow">Full name</span>
      <input name="name" type="text" placeholder="Jane Carter" autocomplete="name" required />
    </label>
    <label class="field">
      <span class="eyebrow">Email</span>
      <input name="email" type="email" placeholder="jane@company.com" autocomplete="email" required />
    </label>
  </fieldset>

  <fieldset class="form__panel" data-step="1" data-question="What do you need?">
    <legend class="sr-only">Services</legend>
    <div class="chips">
      {
        serviceOptions.map((o) => (
          <label class="chip">
            <input type="checkbox" name="service" value={o} />
            <span>{o}</span>
          </label>
        ))
      }
    </div>
    <span class="eyebrow form__sub">Budget</span>
    <div class="chips">
      {
        budgets.map((o) => (
          <label class="chip">
            <input type="radio" name="budget" value={o} />
            <span>{o}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="form__panel" data-step="2" data-question="Tell us more">
    <legend class="sr-only">Project details</legend>
    <label class="field">
      <span class="eyebrow">Your project</span>
      <textarea name="message" rows="4" placeholder="Brand, timeline, a site you admire…"></textarea>
    </label>
  </fieldset>

  <div class="form__panel form__done" data-step="3">
    <p class="serif">Thank you.</p>
    <span>Your email app will open with the details. We reply within 48 business hours.</span>
  </div>

  <input type="text" name="company" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form__actions">
    <button type="button" class="form__back eyebrow" data-form-back hidden>← Back</button>
    <button type="submit" class="pill form__next" data-form-next>Continue</button>
  </div>
  <div class="form__bar"><span data-form-bar></span></div>
  <p class="form__foot">Reply within 48 business hours.</p>
</form>

<style>
  .form {
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 30px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent);
  }
  .form__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 28px;
  }
  .form__step strong {
    font-family: var(--f-display);
    font-size: 20px;
  }
  .form__step em,
  .form__q {
    color: var(--muted);
    font-size: 14px;
    margin-left: 4px;
  }
  .form__panel {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: none;
  }
  .form__panel.is-active {
    display: block;
    animation: step-in 0.6s var(--ease);
  }
  .field {
    display: block;
    margin-bottom: 22px;
  }
  .field .eyebrow {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--cream);
    font: inherit;
    font-size: 15px;
    outline: none;
    resize: vertical;
    transition: border-color 0.3s;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #4b4944;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--cream);
  }
  .field.is-invalid input {
    border-color: #c46a5a;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip span {
    display: inline-block;
    padding: 9px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
    transition: 0.3s var(--ease);
  }
  .chip input:checked + span {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }
  .chip input:focus-visible + span {
    outline: 1px solid var(--cream);
    outline-offset: 2px;
  }
  .form__sub {
    display: block;
    margin: 24px 0 10px;
    font-size: 10px;
    color: var(--muted);
  }
  .form__done p {
    font-size: 34px;
    margin-bottom: 8px;
  }
  .form__done span {
    color: var(--muted);
    font-size: 14px;
  }
  .form__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 18px;
    margin-top: 26px;
  }
  .form__back {
    color: var(--muted);
    font-size: 10px;
  }
  .form__back:hover {
    color: var(--cream);
  }
  .form__next {
    border-color: var(--line);
  }
  .form__bar {
    height: 1px;
    background: var(--line);
    margin-top: 26px;
  }
  .form__bar span {
    display: block;
    height: 100%;
    width: 33.33%;
    background: var(--cream);
    transition: width 0.6s var(--ease);
  }
  .form__foot {
    margin-top: 12px;
    font-size: 11px;
    color: var(--muted-dark);
  }

  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 900px) {
    .form {
      padding: 22px;
    }
  }
</style>
