---
// "Start a project" popup: the same 3-step form as the contact section, without scrolling to the bottom.
import { site } from '../data/site.js';
import ContactForm from './ContactForm.astro';
---

<div class="pm" data-project-modal role="dialog" aria-modal="true" aria-labelledby="pm-title" hidden>
  <div class="pm__backdrop" data-modal-close></div>
  <div class="pm__panel" data-modal-panel data-lenis-prevent>
    <button type="button" class="pm__close" data-modal-close aria-label="Close">
      <span></span><span></span>
    </button>
    <div class="pm__intro">
      <span class="eyebrow pm__k">Start a project</span>
      <h2 id="pm-title" class="serif pm__title">A project in mind?</h2>
      <a href={`mailto:${site.email}`} class="pm__email">{site.email}</a>
      <p class="pm__note">Three questions, two minutes. A reply within 48 business hours, with a first read of your project.</p>
      <a href={site.calendly} class="pill pm__call" target="_blank" rel="noopener">Book a 30-min call</a>
    </div>
    <ContactForm />
  </div>
</div>

<style>
  .pm {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: var(--gutter);
  }
  .pm[hidden] {
    display: none;
  }
  .pm__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 7, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .pm__panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4vw;
    align-items: end;
    width: min(1100px, 100%);
    max-height: calc(100svh - 2 * var(--gutter));
    overflow-y: auto;
    padding: clamp(28px, 4vw, 56px);
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--ink-2);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
  }
  .pm__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: border-color 0.3s, transform 0.5s var(--ease);
  }
  .pm__close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1px;
    background: var(--cream);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .pm__close span + span {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .pm__close:hover {
    border-color: var(--cream);
    transform: rotate(90deg);
  }
  .pm__k {
    color: var(--muted-dark);
  }
  .pm__title {
    margin: 1.6rem 0 0.6rem;
    font-size: clamp(38px, 4.4vw, 66px);
    line-height: 1.05;
    color: var(--muted);
  }
  .pm__email {
    display: inline-block;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 34px);
    letter-spacing: -0.02em;
    border-bottom: 2px solid currentColor;
    padding-bottom: 4px;
  }
  .pm__note {
    max-width: 320px;
    margin: 2rem 0;
    color: var(--muted-dark);
    font-size: 13px;
    line-height: 1.7;
  }
  .pm__call {
    color: var(--muted);
    border-color: var(--line);
    font-size: 10px;
    padding: 8px 14px;
  }

  @media (max-width: 900px) {
    .pm {
      padding: 0;
      place-items: stretch;
    }
    .pm__panel {
      grid-template-columns: 1fr;
      max-height: 100svh;
      border-radius: 0;
      align-content: start;
      padding-top: 72px;
    }
  }
</style>
