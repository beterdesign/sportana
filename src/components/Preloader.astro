---
import { site } from '../data/site.js';
const items = Array.from({ length: 10 });
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__mark" data-preloader-mark>
    <img src="/brand/mark.svg" alt="" class="preloader__ghost" />
    <img src="/brand/mark.svg" alt="" class="preloader__fill" data-preloader-fill />
  </div>
  <div class="preloader__marquee">
    <div class="preloader__track">
      {items.map(() => <span>{site.name} · {new Date().getFullYear()} ·</span>)}
    </div>
  </div>
  <div class="preloader__count"><span data-preloader-count>0</span><small>%</small></div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink);
    display: grid;
    place-items: center;
  }
  .preloader__mark {
    position: relative;
    height: clamp(120px, 22vh, 200px);
    aspect-ratio: 447 / 497;
  }
  .preloader__mark img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .preloader__ghost {
    opacity: 0.1;
  }
  /* the mark fills up from the bottom as the counter climbs */
  .preloader__fill {
    clip-path: inset(100% 0 0 0);
  }
  .preloader__marquee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 76px;
    overflow: hidden;
    white-space: nowrap;
  }
  .preloader__track {
    display: inline-flex;
    gap: 0.6em;
    animation: preload-marquee 22s linear infinite;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .preloader__count {
    position: absolute;
    right: var(--gutter);
    bottom: 26px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
  }
  .preloader__count small {
    font-family: var(--f-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    margin-left: 2px;
    color: var(--muted);
  }
  @keyframes preload-marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
