---
// Inner-page hero: big sans word, italic serif line, meta strip + intro.
interface Props {
  label: string;
  big: string;
  italic: string;
  meta: string;
  count?: number;
}
const { label, big, italic, meta, count } = Astro.props;
---

<section class="ph">
  <p class="serif ph__label" data-hero-fade>({label})</p>
  <h1 class="ph__title">
    <span class="mask ph__big" data-fit>
      <span data-hero-line>{big}{count && <sup class="ph__count">({String(count).padStart(2, '0')})</sup>}</span>
    </span>
    <span class="mask ph__italic serif"><span data-hero-line>{italic}</span></span>
  </h1>
  <div class="ph__foot">
    <span class="eyebrow ph__meta" data-hero-fade>{meta}</span>
    <p class="ph__intro" data-hero-fade><slot /></p>
  </div>
</section>

<style>
  .ph {
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 130px var(--gutter) 9vh;
    background:
      radial-gradient(ellipse 60% 50% at 70% 30%, rgba(255, 255, 255, 0.035), transparent 70%),
      var(--ink);
  }
  .ph__label {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: auto;
  }
  .ph__title {
    margin: 6vh 0 7vh;
    font-weight: inherit;
  }
  .ph__big {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(44px, 15vw, 250px);
    line-height: 0.86;
    letter-spacing: -0.045em;
    color: var(--cream);
  }
  .ph__count {
    font-family: var(--f-sans);
    font-weight: 500;
    font-size: max(0.09em, 11px);
    letter-spacing: 0.04em;
    color: var(--muted);
    vertical-align: top;
    margin-left: 0.4em;
    position: relative;
    top: 1.2em;
  }
  .ph__italic {
    font-size: clamp(44px, 7.4vw, 124px);
    line-height: 1.05;
    color: var(--muted);
    padding-left: 12vw;
    white-space: nowrap;
  }
  .ph__foot {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: end;
    gap: 2rem;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .ph__meta {
    color: var(--muted-dark);
  }
  .ph__intro {
    max-width: 420px;
    color: #a9a69e;
    font-size: 15px;
    line-height: 1.75;
  }

  @media (max-width: 760px) {
    .ph__foot {
      grid-template-columns: 1fr;
    }
    .ph__italic {
      padding-left: 6vw;
      white-space: normal;
    }
  }
</style>
