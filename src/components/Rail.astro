---
// Horizontal product rail with arrows (drag/swipe on touch through native scroll snapping).
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';

interface Props {
  title: string;
  eyebrow?: string;
  text?: string;
  href?: string;
  linkLabel?: string;
  products: any[];
  id?: string;
}
const { title, eyebrow, text, href, linkLabel = 'Pogledaj sve', products, id } = Astro.props;
---

<section class="rail" data-rail id={id}>
  <div class="section-head">
    <div data-reveal>
      {eyebrow && <p class="eyebrow muted">{eyebrow}</p>}
      <h2 class="h2">{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="rail__nav">
      {href && <a href={href} class="link">{linkLabel}</a>}
      <button class="rail__btn" data-rail-prev aria-label="Prethodni proizvodi"><Icon name="arrow" size={20} class="flip" /></button>
      <button class="rail__btn" data-rail-next aria-label="Sledeći proizvodi"><Icon name="arrow" size={20} /></button>
    </div>
  </div>
  <div class="rail__track" data-rail-track data-qa-ignore>
    {products.map((p, i) => <div class="rail__item"><ProductCard p={p} index={i} /></div>)}
  </div>
</section>

<style>
  .rail__nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rail__nav .link {
    margin-right: 14px;
  }
  .rail__btn {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--ink);
    transition:
      background 0.25s,
      opacity 0.25s;
  }
  .rail__btn:hover {
    background: var(--volt);
  }
  .rail__btn[disabled] {
    opacity: 0.25;
    pointer-events: none;
  }
  .rail__btn :global(.flip) {
    transform: rotate(180deg);
  }
  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(220px, 22vw, 340px);
    gap: clamp(12px, 1.4vw, 20px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .rail__track::-webkit-scrollbar {
    display: none;
  }
  .rail__item {
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (max-width: 760px) {
    .rail__track {
      grid-auto-columns: 62vw;
    }
    .rail__btn {
      display: none;
    }
    .rail__nav .link {
      margin-right: 0;
    }
  }
</style>
