---
import { site } from '../data/site.js';
import { getFeaturedProjects } from '../lib/sanity.js';
const featured = (await getFeaturedProjects()).slice(0, 3);
const words = Array.from({ length: 8 });
// stacked copies of the mark, spaced in depth, give the spinning logo some thickness
const layers = Array.from({ length: 14 }, (_, i) => i);
---

<section class="hero" data-hero>
  <h1 class="sr-only">{site.name}, TODO: what the business is</h1>

  <div class="hero__mark" data-hero-mark aria-hidden="true">
    <div class="hero__tilt" data-hero-tilt>
      <div class="hero__spin" data-hero-spin>
        {
          layers.map((i) => (
            <img
              src={site.mark}
              alt=""
              class:list={['hero__layer', { 'is-face': i === 0 || i === layers.length - 1 }]}
              style={`--z:${i - (layers.length - 1) / 2}`}
            />
          ))
        }
      </div>
    </div>
  </div>

  <div class="hero__title" aria-hidden="true">
    <p class="eyebrow hero__eyebrow" data-hero-fade>TODO · eyebrow · line</p>
    <span class="mask hero__big"><span data-hero-line>TODO</span></span>
    <span class="mask hero__italic serif"><span data-hero-line>todo line.</span></span>
  </div>

  <aside class="hero__side">
    <p class="hero__intro" data-hero-fade>
      TODO: two sentences on who the client is and who they serve.
    </p>
    <ol class="hero__list">
      {
        featured.map((p, i) => (
          <li data-hero-fade>
            <a href={p.href} class="hero__item" data-preview={p.image}>
              <span class="hero__num">0{i + 1}</span>
              <span class="hero__name">{p.name}</span>
              <span class="hero__arrow">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </aside>

  <div class="cursor-preview" data-cursor-preview aria-hidden="true"><img alt="" /></div>

  <div class="hero__marquee" aria-hidden="true">
    <div class="hero__track" data-marquee>
      {
        words.map(() => (
          <span class="hero__word">
            {site.name}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 55% 35%, rgba(255, 255, 255, 0.045), transparent 70%),
      var(--ink);
  }

  .hero__mark {
    position: absolute;
    top: 9%;
    left: 41%;
    height: 72%;
    pointer-events: none;
    perspective: 1400px;
  }
  .hero__tilt,
  .hero__spin {
    height: 100%;
    transform-style: preserve-3d;
  }
  .hero__spin {
    position: relative;
    aspect-ratio: 447 / 497;
    will-change: transform;
  }
  .hero__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: translateZ(calc(var(--z) * 2.6px));
    /* inner layers read as the lit edge of a dark, solid object */
    filter: brightness(0.3);
    opacity: 0.55;
    backface-visibility: visible;
  }
  .hero__layer.is-face {
    filter: brightness(0.13);
    opacity: 1;
  }

  .hero__title {
    position: relative;
    z-index: 2;
    padding-bottom: 6vh;
  }
  .hero__eyebrow {
    color: var(--muted);
    margin-bottom: 1.4rem;
    padding-left: 0.4vw;
  }
  .hero__big {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(48px, 13.4vw, 220px);
    line-height: 0.86;
    letter-spacing: -0.035em;
    color: var(--cream);
  }
  .hero__italic {
    font-size: clamp(40px, 6vw, 100px);
    line-height: 1.05;
    color: var(--muted);
    padding-left: 9vw;
    white-space: nowrap;
    margin-top: 0.06em;
  }

  .hero__side {
    position: relative;
    z-index: 2;
    justify-self: end;
    width: min(100%, 380px);
    margin-top: 18vh;
  }
  .hero__intro {
    color: #a9a69e;
    font-size: 14px;
    line-height: 1.75;
    margin-bottom: 2rem;
  }
  .hero__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__item {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    transition: padding 0.5s var(--ease);
  }
  .hero__item:hover {
    padding-left: 10px;
  }
  .hero__num {
    font-size: 10px;
    color: var(--muted-dark);
    letter-spacing: 0.1em;
  }
  .hero__name {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 17px;
  }
  .hero__arrow {
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: 0.5s var(--ease);
  }
  .hero__item:hover .hero__arrow {
    opacity: 1;
    transform: none;
  }

  .hero__marquee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid var(--line);
    overflow: hidden;
    white-space: nowrap;
    padding: 1.2vw 0 0.4vw;
  }
  .hero__track {
    display: inline-flex;
    will-change: transform;
  }
  .hero__word {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(54px, 7vw, 110px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #2b2a27;
    padding-right: 0.5em;
  }
  .hero__word em {
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 3rem;
      padding-top: 110px;
      padding-bottom: 140px;
    }
    .hero__mark {
      left: 34%;
      top: 10%;
      height: 46%;
    }
    .hero__side {
      justify-self: start;
      margin-top: 0;
    }
    .hero__title {
      padding-bottom: 0;
    }
  }
</style>
