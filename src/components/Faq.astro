---
interface Props {
  title: string;
  intro?: string;
  items: { q: string; a: string }[];
  label?: string;
  // the /faq page renders several groups and emits one combined schema instead
  schema?: boolean;
}
const { title, intro, items, label = 'Questions', schema: withSchema = true } = Astro.props;

// FAQPage schema helps both Google and AI answer engines quote these answers.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section class="faq">
  <span class="eyebrow faq__label">({label})</span>
  <div class="faq__head" data-reveal>
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <div class="faq__list">
    {
      items.map((item, i) => (
        <details class="faq__item" open={i === 0}>
          <summary>
            <span class="serif faq__num">({String(i + 1).padStart(2, '0')})</span>
            <span class="faq__q">{item.q}</span>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <p class="faq__a">{item.a}</p>
        </details>
      ))
    }
  </div>
  {withSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>

<style>
  .faq {
    padding: 14vh var(--gutter) 10vh;
    background: var(--ink);
    border-top: 1px solid var(--line);
  }
  .faq__label {
    display: block;
    color: var(--muted-dark);
    margin-bottom: 4vh;
  }
  .faq__head {
    max-width: 640px;
    margin-bottom: 8vh;
  }
  .faq__head h2 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(32px, 3.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 1.4rem;
  }
  .faq__head p {
    color: #bdb9b0;
    line-height: 1.75;
  }
  .faq__item {
    border-top: 1px solid var(--line);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: 90px 1fr 24px;
    gap: 2rem;
    align-items: center;
    padding: 28px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__num {
    color: var(--muted);
  }
  .faq__q {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(19px, 1.7vw, 26px);
    letter-spacing: -0.01em;
  }
  .faq__icon {
    position: relative;
    width: 14px;
    height: 14px;
    justify-self: end;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__a {
    max-width: 620px;
    margin: -6px 0 0 calc(90px + 2rem);
    padding-bottom: 30px;
    color: var(--muted);
    line-height: 1.8;
  }

  @media (max-width: 760px) {
    summary {
      grid-template-columns: 1fr 24px;
    }
    .faq__num {
      display: none;
    }
    .faq__a {
      margin-left: 0;
    }
  }
</style>
